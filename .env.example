# Wired Terminal configuration. Copy to `.env` and edit, or export in your shell.
# The backend reads these at startup; nothing here is required for local use.
#
# There is also a settings file now — the desktop app writes one so a packaged
# build can be configured by clicking. Anything set here still wins over it, so
# scripts, systemd units and install-ubuntu.sh behave exactly as before. The
# Settings screen greys out any control the environment has taken over.
#
#   macOS   ~/Library/Application Support/com.wired.terminal/settings.json
#   Linux   ~/.config/wired-terminal/settings.json
#   Windows %APPDATA%\com.wired.terminal\settings.json

# ── Network ─────────────────────────────────────────────────────────────
# Loopback by default. Binding anywhere else REQUIRES WIRED_AUTH_TOKEN —
# the backend refuses to start otherwise, because this API can run commands.
WIRED_HOST=127.0.0.1
WIRED_PORT=8000

# Bind the next free port when WIRED_PORT is taken instead of failing to start.
# On by default for the desktop app, which can tell its own window where it
# went; off for the server, whose port is somebody's firewall rule.
# WIRED_PORT_FALLBACK=0

# ── Auth ────────────────────────────────────────────────────────────────
# Unset = no auth (fine on loopback). When set, every /api call and the
# WebSocket need `Authorization: Bearer <token>`; EventSource and the reader
# page fall back to `?token=<token>`.
# Generate one with: head -c 24 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
#
# The desktop app keeps its token in the OS keychain instead, so a packaged
# build can be given one after it was built. Set this and it wins.
# WIRED_AUTH_TOKEN=

# Use the OS keychain for the API token and the chat bot token. Turn it off on a
# headless machine, where a keychain prompt is a hang rather than a dialog.
# WIRED_USE_KEYCHAIN=1

# Comma-separated browser origins allowed to call the API. `*` disables the
# check entirely — only do that behind a trusted proxy.
# WIRED_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost

# Last-resort override to bind off-host with no token. Do not use.
# WIRED_ALLOW_INSECURE=0

# ── Agent behaviour ─────────────────────────────────────────────────────
# claude | grok | codex | gemini. Defaults to the first CLI found on PATH.
# WIRED_ASSISTANT_PROVIDER=claude

# Restart the CLI when it exits (the "24/7" part).
WIRED_ASSISTANT_KEEP_ALIVE=1

# Start the agent as soon as the API boots.
WIRED_ASSISTANT_AUTO_START=0

# Where the agent works. Defaults to the server's working directory, falling
# back to $HOME when that is `/` (which is what a GUI launch inherits).
# WIRED_AGENT_CWD=

# PTY geometry for the agent session.
WIRED_ASSISTANT_COLS=100
WIRED_ASSISTANT_ROWS=32

# Launch the CLIs with their approval prompts pre-answered
# (claude --dangerously-skip-permissions, grok --always-approve,
# codex --dangerously-bypass-approvals-and-sandbox, gemini --yolo --skip-trust).
# This is what makes unattended operation possible. Set to 0 and the agent
# will stop and wait for approval, surfaced as a `prompt` event on the stream.
WIRED_AGENT_AUTO_APPROVE=1

# Which defaults apply. `desktop` makes the agent ask before it acts, because
# there is somebody there to press Allow. Anything else keeps the unattended
# default of pre-answered approvals. The desktop app sets this itself.
# WIRED_PROFILE=

# ── History ─────────────────────────────────────────────────────────────
# Write the transcript and schedules to disk (one NDJSON file per day).
# WIRED_PERSIST=1

# Days of transcript to keep. 0 keeps everything.
# WIRED_TRANSCRIPT_DAYS=30

# Override where settings, history and logs live. Mostly for tests and for
# running several instances side by side.
# WIRED_CONFIG_DIR=
# WIRED_DATA_DIR=

# ── Logging ─────────────────────────────────────────────────────────────
# Logs go to stdout *and* to a daily file, because a packaged `.app` launch has
# no terminal to read: ~/Library/Logs/com.wired.terminal (macOS), or
# <data dir>/logs elsewhere.
# WIRED_LOG_LEVEL=INFO

# ── Frontend (app/.env) ─────────────────────────────────────────────────
# Read by Vite at build time. These are the dev-server fallback only: the
# packaged app asks the desktop shell for its port and token at runtime, which
# is what lets a build be configured after it was compiled.
# VITE_API_BASE=http://127.0.0.1:8000
# VITE_AUTH_TOKEN=
